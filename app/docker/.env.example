# DQX Studio — local container configuration.
# Copy to `.env` (cp .env.example .env) and fill in your values.
# `.env` is git-ignored and is never baked into the image.
#
# DQX Studio does NOT provision anything locally — every value below must point
# at Databricks resources that already exist (from a `make app-deploy` or made
# by hand). See app/DEVELOPMENT.md ("Bring your own SQL warehouse, catalog, and
# Lakebase") for how to obtain them.

# ---------------------------------------------------------------------------
# Databricks authentication — OAuth service principal (M2M)
# ---------------------------------------------------------------------------
# Workspace URL plus the SP's application id and OAuth secret. The whole app
# (service and user calls) runs as this SP. See README.md "Set up the service
# principal" for the one-time setup. In a cloud deployment, inject these from
# the platform's secret manager instead of a file.
DATABRICKS_HOST=https://<workspace-host>
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# Lets user-facing requests — which carry no Databricks Apps identity headers in
# a standalone container — run as the SP. Required with SP env credentials;
# never set on Databricks Apps. Every request runs as the SP with no per-user
# authentication, so don't expose this container to untrusted callers. A shared
# deployment should instead sit behind an authenticating proxy that injects
# X-Forwarded-Access-Token / X-Forwarded-Email, with this flag unset.
DQX_DEFAULT_AUTH_FALLBACK=1

# ---------------------------------------------------------------------------
# Required resources (must already exist; the SP needs access to each)
# ---------------------------------------------------------------------------
# SQL warehouse id (the SP needs CAN_USE), e.g. abc123def456.
DATABRICKS_WAREHOUSE_ID=

# Unity Catalog catalog + schemas (the SP needs USE CATALOG + ALL PRIVILEGES on
# the schemas, plus SELECT on any tables you want to browse or profile).
DQX_CATALOG=dqx
DQX_SCHEMA=dqx_studio
DQX_TMP_SCHEMA=dqx_studio_tmp
DQX_GENIE_SCHEMA=genie

# Wheels volume (UC volume path). Must exist; format /Volumes/<cat>/<schema>/wheels.
DQX_WHEELS_VOLUME=/Volumes/dqx/dqx_studio/wheels

# Lakebase (Postgres) — MANDATORY. The SP needs a Postgres role on this branch.
DQX_LAKEBASE_ENDPOINT=projects/dqx-studio-db/branches/dqx/endpoints/primary
DQX_LAKEBASE_DATABASE_NAME=databricks_postgres
# Keep this separate from a deployed app's `dqx_studio` schema: tables there are
# owned by the app's own SP, so migrations run as a different SP fail with
# "must be owner of table".
DQX_LAKEBASE_SCHEMA=dqx_studio_local

# Workspace group granting the in-app ADMIN role. The SP must be a member.
# Use a dedicated group — adding the SP to `admins` makes it a workspace admin.
DQX_ADMIN_GROUP=dqx-studio-local-admins

# ---------------------------------------------------------------------------
# Build-time package proxies (only needed where public PyPI / npm are blocked,
# e.g. a corporate network). Used by `docker compose build`; ignored at runtime.
# Discover your host's values with:
#     echo "$UV_INDEX_URL"        # Python index (uv)
#     npm config get registry     # npm/yarn registry
# Leave both unset on a network with public registry access.
# ---------------------------------------------------------------------------
# UV_INDEX_URL=
# NPM_REGISTRY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Task-runner job id — required only for profiler / dry-run / scheduled runs.
# DQX_JOB_ID=

# Registered app slug used for app-permissions lookups (default dqx-studio).
# DQX_APP_NAME=dqx-studio

# Set to 1 to skip the in-process scheduler locally.
# DQX_SCHEDULER_DISABLED=1
