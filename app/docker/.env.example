# DQX Studio — local container configuration.
# Copy to `.env` (cp .env.example .env) and fill in your values.
# `.env` is git-ignored and is never baked into the image.
#
# The SQL warehouse and the Lakebase project must already exist. setup.sh
# creates the catalog, schemas, wheels volume, and Lakebase database when they
# are missing, and grants the permissions (README.md "Set up").

# ---------------------------------------------------------------------------
# Databricks authentication — OAuth service principal (M2M)
# ---------------------------------------------------------------------------
# Workspace URL plus the SP's application id and OAuth secret. The whole app
# (service and user calls) runs as this SP. See README.md "Set up" for the
# one-time setup. In a cloud deployment, inject these from the platform's
# secret manager instead of a file.
DATABRICKS_HOST=https://<workspace-host>
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# Lets user-facing requests — which carry no Databricks Apps identity headers in
# a standalone container — run as the SP. Required with SP env credentials;
# never set on Databricks Apps. Every request runs as the SP with no per-user
# authentication, so don't expose this container to untrusted callers. A shared
# deployment should instead sit behind an authenticating proxy that injects
# X-Forwarded-Access-Token / X-Forwarded-Email, with this flag unset.
DQX_DEFAULT_AUTH_FALLBACK=1

# ---------------------------------------------------------------------------
# Resources
# ---------------------------------------------------------------------------
# SQL warehouse id, e.g. abc123def456. Must already exist.
DATABRICKS_WAREHOUSE_ID=

# Unity Catalog catalog + schemas. The app takes its catalog and main schema
# from DQX_WHEELS_VOLUME, so keep these two matching it. When the tmp / genie
# names are unset it derives <schema>_tmp and <schema>_genie; the values below
# match the schemas a `make app-deploy` bundle creates.
DQX_CATALOG=dqx
# Main schema: Delta results (runs, metrics, quarantine, profiling).
DQX_SCHEMA=dqx_studio
DQX_TMP_SCHEMA=dqx_studio_tmp
DQX_GENIE_SCHEMA=genie

# Wheels volume (UC volume path): /Volumes/<catalog>/<schema>/<volume>.
DQX_WHEELS_VOLUME=/Volumes/dqx/dqx_studio/wheels

# Storage root for the catalog, used only when setup.sh creates it and the
# metastore has no default storage.
# DQX_CATALOG_STORAGE_ROOT=abfss://<container>@<account>.dfs.core.windows.net/<path>

# Lakebase (Postgres) — MANDATORY. The project and its endpoint must already
# exist; setup.sh creates the database when it is missing. The default below
# expects a project named dqx-studio-db (the name `make app-deploy` uses) and
# its default `production` branch: create the project under that name, or
# change the path to match yours.
DQX_LAKEBASE_ENDPOINT=projects/dqx-studio-db/branches/production/endpoints/primary
DQX_LAKEBASE_DATABASE_NAME=databricks_postgres
# Postgres schema (not Unity Catalog) for OLTP state: rules, schedules,
# settings, role mappings. Keep it separate from a deployed app's `dqx_studio`
# schema: tables there are owned by the app's own SP, so migrations run as a
# different SP fail with "must be owner of table".
DQX_LAKEBASE_SCHEMA=dqx_studio_local

# Workspace group granting the in-app ADMIN role; setup.sh creates it and adds
# the SP. Use a dedicated group — adding the SP to `admins` makes it a workspace
# admin.
DQX_ADMIN_GROUP=dqx-studio-local-admins

# ---------------------------------------------------------------------------
# Build-time package proxies (only needed where public PyPI / npm are blocked,
# e.g. a corporate network). Used by `docker compose build`; ignored at runtime.
# Discover your host's values with:
#     echo "$UV_INDEX_URL"        # Python index (uv)
#     npm config get registry     # npm/yarn registry
# Leave both unset on a network with public registry access.
# ---------------------------------------------------------------------------
# UV_INDEX_URL=
# NPM_REGISTRY=

# Task-runner job. Setup completes only once this job runs as a service
# principal DIFFERENT from DATABRICKS_CLIENT_ID (see README "Set up"). Point
# it at an existing job, e.g. the task-runner job of a `make app-deploy`; when
# unset, setup.sh creates one.
# DQX_JOB_ID=

# Task-runner service principal (application id). setup.sh makes it the
# job's run-as and grants its access; the app itself doesn't read it.
# DQX_TASK_RUNNER_CLIENT_ID=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Registered app slug used for app-permissions lookups (default dqx-studio).
# DQX_APP_NAME=dqx-studio

# Set to 1 to skip the in-process scheduler locally.
# DQX_SCHEDULER_DISABLED=1
